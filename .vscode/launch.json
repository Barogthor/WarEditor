        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'editor-runner'",
            "cargo": {
                "args": [
                    "build",
                    "--bin=editor-runner",
                    "--package=editor-runner"
                ],
                "filter": {
                    "name": "editor-runner",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in executable 'editor-runner'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--bin=editor-runner",
                    "--package=editor-runner"
                ],
                "filter": {
                    "name": "editor-runner",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug workspace tests",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--workspace"
                ],
                "filter": {
                    "kind": "lib"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Run editor-runner",
            "cargo": {
                "args": [
                    "run",
                    "--package=editor-runner"
                ],
                "filter": {
                    "name": "editor-runner",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                "RUST_LOG": "debug"
