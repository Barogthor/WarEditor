function Trig_TriggerIfThenElse_Func001001 takes nothing returns boolean
    return ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_STRUCTURE) == true )
endfunction

function Trig_TriggerIfThenElse_Actions takes nothing returns nothing
