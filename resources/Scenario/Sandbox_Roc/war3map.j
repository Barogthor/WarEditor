function CreateRegions takes nothing returns nothing
    local weathereffect we

    set gg_rct_Red = Rect( -832.0, -640.0, -480.0, -256.0 )
    set we = AddWeatherEffect( gg_rct_Red, 'RAhr' )
    call EnableWeatherEffect( we, true )
    call SetSoundPosition( gg_snd_RainAmbience, -656.0, -448.0, 0.0 )
    call RegisterStackedSound( gg_snd_RainAmbience, true, 352.0, 384.0 )
    set gg_rct_LightGreen = Rect( 416.0, -32.0, 768.0, 352.0 )
    call SetSoundPosition( gg_snd_Avatar, 592.0, 160.0, 0.0 )
    call RegisterStackedSound( gg_snd_Avatar, true, 352.0, 384.0 )
    set gg_rct_White = Rect( 384.0, -1056.0, 416.0, -640.0 )
endfunction

