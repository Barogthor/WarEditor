function InitSounds takes nothing returns nothing
    set gg_snd_RainAmbience = CreateSound( "Sound\\Ambient\\RainAmbience.wav", false, false, false, 10, 10, "DefaultEAXON" )
    call SetSoundParamsFromLabel( gg_snd_RainAmbience, "AmbientSoundRain" )
    call SetSoundDuration( gg_snd_RainAmbience, 4418 )
    set gg_snd_WindLoopStereo = CreateSound( "Sound\\Ambient\\WindLoopStereo.wav", false, false, false, 10, 10, "DefaultEAXON" )
    call SetSoundParamsFromLabel( gg_snd_WindLoopStereo, "AmbientSoundTestWind" )
    call SetSoundDuration( gg_snd_WindLoopStereo, 11036 )
    set gg_snd_RainAmbience01 = CreateSound( "Sound\\Ambient\\RainAmbience.wav", false, false, false, 10, 10, "DefaultEAXON" )
    call SetSoundParamsFromLabel( gg_snd_RainAmbience01, "AmbientSoundRain" )
    call SetSoundDuration( gg_snd_RainAmbience01, 4418 )
    call SetSoundVolume( gg_snd_RainAmbience01, 127 )
    set gg_snd_Avatar = CreateSound( "Abilities\\Spells\\Human\\Avatar\\Avatar.wav", false, true, true, 10, 10, "SpellsEAX" )
    call SetSoundParamsFromLabel( gg_snd_Avatar, "Avatar" )
    call SetSoundDuration( gg_snd_Avatar, 3199 )
    call SetSoundDistances( gg_snd_Avatar, 650.0, 10010.0 )
    call SetSoundDistanceCutoff( gg_snd_Avatar, 3010.0 )
    set gg_snd_Credits = "Sound\\Music\\mp3Music\\Credits.mp3"
endfunction

