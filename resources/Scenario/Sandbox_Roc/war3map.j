function InitRandomGroups takes nothing returns nothing
    local integer curset

    // Group 0 - TestRandGroupUnit
    call RandomDistReset(  )
    call RandomDistAddItem( 0, 95 )
    call RandomDistAddItem( 1, 5 )
    set curset = RandomDistChoose(  )

    if (curset == 0) then
        set gg_rg_000[0] = ChooseRandomCreep( 6 )
        set gg_rg_000[1] = ChooseRandomCreep( 10 )
    elseif (curset == 1) then
        set gg_rg_000[0] = 'nrwm'
        set gg_rg_000[1] = -1
    else
        set gg_rg_000[0] = -1
        set gg_rg_000[1] = -1
    endif

    // Group 1 - TestRandGroupItem
    call RandomDistReset(  )
    call RandomDistAddItem( 0, 50 )
    call RandomDistAddItem( 1, 50 )
    set curset = RandomDistChoose(  )

    if (curset == 0) then
        set gg_rg_001[0] = ChooseRandomItemEx( ITEM_TYPE_CHARGED, 2 )
        set gg_rg_001[1] = 'desc'
    elseif (curset == 1) then
        set gg_rg_001[0] = 'ofro'
        set gg_rg_001[1] = 'desc'
    else
        set gg_rg_001[0] = -1
        set gg_rg_001[1] = -1
    endif

endfunction

